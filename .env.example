# Host-machine specific configuration for DiffBrushWithGerman.
# Copy this file to `.env` (git-ignored) and adjust per machine.
# Precedence: command-line flag > process environment > .env > built-in default.

# Device backend: cuda | mps | cpu
# (mps for Apple Silicon, cuda for NVIDIA hosts)
DEVICE=cuda

# Released IAM checkpoint (see scripts/download_model_zoo.py for a fresh clone)
PRETRAINED_MODEL=model_zoo/checkpoint/diffbrush_iam.pt

# Frozen SD-1.5 VAE
STABLE_DIF_PATH=model_zoo/stable-diffusion-v1-5

# Output dir for generate.py probes
SAVE_DIR=reports/phase0_probe

# Optional: only needed if your network requires Hugging Face auth for downloads
# HF_TOKEN=
